{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erpindo",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // Cloudflare Workers Builds (integrasi Git) menjalankan `npx wrangler deploy`
  // dari root repo; custom build di bawah memastikan SPA ter-build lebih dulu.
  "build": {
    "command": "pnpm --filter @erpindo/web build"
  },

  // SPA hasil build apps/web dilayani oleh Worker yang sama.
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__scheduled", "/blog", "/blog/*", "/sitemap.xml", "/robots.txt", "/api-docs", "/", "/fitur"]
  },

  // ID di bawah menunjuk sumber daya di akun Cloudflare yang MENERIMA deploy.
  //
  // Diperbarui seluruhnya pada 17 Agustus 2026: ID sebelumnya milik akun lain
  // dan **404 di akun ini** — Worker ter-deploy dengan sukses tetapi setiap
  // request yang menyentuh database gagal, karena binding D1 dan KV terikat
  // pada akun dan tidak bisa menunjuk lintas akun berapa pun ID-nya.
  //
  // Seluruh database dibuat di region APAC (terdekat ke Indonesia).
  "d1_databases": [
    // Control-plane: akun, tenant, langganan.
    {
      "binding": "DB",
      "database_name": "erpindo-control-plane",
      "database_id": "c525c4e3-9f7a-42ea-bc78-f0035f2dece2"
    },
    // Pool database tenant. Di mode "local" (dev/test & produksi awal) tenant
    // baru dipetakan ke pool ini; migrasi ke D1 dinamis via REST API tinggal
    // mengganti TENANT_DB_MODE ke "cloudflare" + secret API token.
    { "binding": "TENANT_DB_1", "database_name": "erpindo-tenant-1", "database_id": "d5eab9f6-0a14-4c2c-995d-967e0d136b39" },
    { "binding": "TENANT_DB_2", "database_name": "erpindo-tenant-2", "database_id": "48e88c27-351e-4c92-b895-f7f943ed2019" },
    { "binding": "TENANT_DB_3", "database_name": "erpindo-tenant-3", "database_id": "51d31dd0-1b67-435e-b103-47b841707088" },
    { "binding": "TENANT_DB_4", "database_name": "erpindo-tenant-4", "database_id": "7573b5b1-c59e-4d4e-9279-55b9d0e93133" },
    { "binding": "TENANT_DB_5", "database_name": "erpindo-tenant-5", "database_id": "b71c597b-0f40-426f-b08b-d17ec79fa122" },
    { "binding": "TENANT_DB_6", "database_name": "erpindo-tenant-6", "database_id": "19529a13-ca43-467d-8a1b-278b52d03476" }
  ],

  "kv_namespaces": [
    { "binding": "RATE_KV", "id": "f84f208b97034a33b7748b3eaf14827d" }
  ],

  // Penghitung rate limit (Fase 30e). Menggantikan tulis-KV-per-request, yang
  // menabrak kuota tulis KV paket gratis (1.000/hari) jauh sebelum batas
  // 100.000 request/hari. Durable Object tersedia di paket gratis maupun
  // berbayar dan tidak memakan kuota KV sama sekali.
  //
  // `new_sqlite_classes` (bukan `new_classes`): kelas DO berbasis SQLite
  // adalah yang tersedia di paket gratis.
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],

  // Workers AI (Asisten erpindo) — kuota gratis 10.000 neuron/hari.
  // Di dev lokal tanpa login Cloudflare, panggilan AI gagal saat runtime dan
  // API mengubahnya menjadi 503 (degradasi anggun) — lihat routes/ai.ts.
  "ai": { "binding": "AI" },

  // PERINGATAN (Fase 23c): mengubah ini ke "cloudflare" TANPA lebih dulu
  // memasang secret CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID membuat
  // SELURUH pendaftaran gagal (lihat provisionTenantDb di lib/tenantDb.ts) —
  // lebih buruk daripada batas 6 perusahaan yang berlaku sekarang.
  // Pasang secret dulu, deploy, baru ubah baris ini. Langkah lengkap +
  // verifikasinya ada di docs/05-runbook-go-live.md §6.
  "vars": {
    "TENANT_DB_MODE": "local"
  },

  // Job harian: siklus hidup langganan (trial berakhir → mode baca-saja).
  "triggers": {
    "crons": ["17 1 * * *"]
  },

  "observability": {
    "enabled": true
  }
}
