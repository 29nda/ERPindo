{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src", "test"],
  // Uji-uji ini membaca berkas sumber via node:fs — butuh tipe Node yang
  // bentrok dengan @cloudflare/workers-types. Semuanya TETAP dijalankan penuh
  // oleh vitest; yang dilewati hanya pemeriksaan tipenya.
  //
  // `token-publik.test.ts` ditambahkan pada Fase 38q setelah `pnpm typecheck`
  // menemukannya merah. Ia dibuat di Fase 38g dan divalidasi dengan vitest
  // saja; typecheck penuh tidak dijalankan ulang sesudah berkas itu ada, dan
  // log 38g karena itu menyatakan typecheck hijau padahal tidak. Koreksinya
  // dicatat di log 38q.
  "exclude": [
    "test/rbac-guard.test.ts",
    "test/pesan-galat.test.ts",
    "test/token-publik.test.ts",
    "test/kodeAkunUnik.test.ts",
    "test/fiturTertinggal.test.ts"
  ]
}
